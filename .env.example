# NASA FIRMS API Map Key
# Obtain a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# The Guardian Open Platform API Key
# Obtain a free developer key at: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your_guardian_api_key_here

# ACLED Ground-Truth Conflict Database Credentials (Optional)
# Register at: https://acleddata.com/register/
# If left blank, the pipeline falls back to cached data in data/acled_events_raw.csv (if available locally).
ACLED_USER=your_acled_email_here
ACLED_PASS=your_acled_password_here

# PostgreSQL Database Connection URL (Docker default)
DATABASE_URL=postgresql://ce49x@localhost:5432/conflict_monitoring
